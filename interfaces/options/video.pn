fullscreen:  true
items:
	fullscreen:
		type:    "checkbox"
		bounds:  {left: 100, top: 111, right: 300, bottom: 121}
		label:   "Fullscreen"
		hue:     "pale-purple"
		style:   "large"
	resolution/fill:
		type:    "checkbox"
		bounds:  {left: 100, top: 154, right: 212, bottom: 164}
		label:   "Fill Screen"
		hue:     "pale-purple"
		style:   "large"
	resolution/640x480:
		type:    "checkbox"
		bounds:  {left: 272, top: 154, right: 384, bottom: 164}
		label:   "640 x 480"
		hue:     "pale-purple"
		style:   "large"
	resolution/800x600:
		type:    "checkbox"
		bounds:  {left: 444, top: 154, right: 556, bottom: 164}
		label:   "800 x 600"
		hue:     "pale-purple"
		style:   "large"
	resolution/1024x768:
		type:    "checkbox"
		bounds:  {left: 100, top: 187, right: 212, bottom: 197}
		label:   "1024 x 768"
		hue:     "pale-purple"
		style:   "large"
	resolution/1280x960:
		type:    "checkbox"
		bounds:  {left: 272, top: 187, right: 384, bottom: 197}
		label:   "1280 x 960"
		hue:     "pale-purple"
		style:   "large"
	resolution/1280x720:
		type:    "checkbox"
		bounds:  {left: 444, top: 187, right: 556, bottom: 197}
		label:   "1280 x 720"
		hue:     "pale-purple"
		style:   "large"
	resolution/1366x768:
		type:    "checkbox"
		bounds:  {left: 100, top: 220, right: 212, bottom: 230}
		label:   "1366 x 768"
		hue:     "pale-purple"
		style:   "large"
	resolution/1600x900:
		type:    "checkbox"
		bounds:  {left: 272, top: 220, right: 384, bottom: 230}
		label:   "1600 x 900"
		hue:     "pale-purple"
		style:   "large"
	resolution/1920x1080:
		type:    "checkbox"
		bounds:  {left: 444, top: 220, right: 556, bottom: 230}
		label:   "1920 x 1080"
		hue:     "pale-purple"
		style:   "large"

	game-scale/native:
		type:    "checkbox"
		bounds:  {left: 100, top: 297, right: 212, bottom: 307}
		label:   "Native"
		hue:     "pale-purple"
		style:   "large"
	game-scale/whole:
		type:    "checkbox"
		bounds:  {left: 272, top: 297, right: 384, bottom: 307}
		label:   "Whole"
		hue:     "pale-purple"
		style:   "large"
	game-scale/fill:
		type:    "checkbox"
		bounds:  {left: 444, top: 297, right: 556, bottom: 307}
		label:   "Fill Height"
		hue:     "pale-purple"
		style:   "large"

	cancel:
		type:     "button"
		bounds:   {left: 60, top: 407, right: 220, bottom: 417}
		label:    "Cancel"
		key:      "ESC"
		gamepad:  "B"
		hue:      "yellow"
		style:    "large"
	done:
		type:     "button"
		bounds:   {left: 420, top: 407, right: 580, bottom: 417}
		label:    "Done"
		key:      "RTRN"
		gamepad:  "A"
		hue:      "pale-green"
		style:    "large"

	options:
		type:    "button"
		bounds:  {left: 420, top: 377, right: 580, bottom: 387}
		label:   "Sound"
		key:     "S"
		hue:     "aqua"
		style:   "large"
	key-controls:
		type:    "button"
		bounds:  {left: 420, top: 347, right: 580, bottom: 357}
		label:   "Key Controls"
		key:     "K"
		hue:     "aqua"
		style:   "large"

	tablet/left:
		type:     "picture"
		bounds:   {left: 2, top: 0, right: 102, bottom: 481}
		picture:  "gui/tablet/left"
	tablet/top:
		type:     "picture"
		bounds:   {left: 35, top: 0, right: 615, bottom: 100}
		picture:  "gui/tablet/top"
	tablet/right:
		type:     "picture"
		bounds:   {left: 607, top: 0, right: 707, bottom: 480}
		picture:  "gui/tablet/right"
	tablet/bottom:
		type:     "picture"
		bounds:   {left: 35, top: 456, right: 615, bottom: 556}
		picture:  "gui/tablet/bottom"

	video-options:
		type:    "rect"
		bounds:  {left: 53, top: 92, right: 588, bottom: 245}
		label:   "Video Options"
		hue:     "indigo"
		style:   "large"
	game-scale:
		type:    "rect"
		bounds:  {left: 53, top: 278, right: 588, bottom: 320}
		label:   "Game Scale"
		hue:     "indigo"
		style:   "large"
